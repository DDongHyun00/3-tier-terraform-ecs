apiVersion: 1

# Slack 경로: Grafana SNS 연락처 → 기존 알람 토픽 → Amazon Q Developer → Slack(DEC-58).
# Q Developer는 사용자 정의 알림 형식(version 1.0, source custom, content.description)의 JSON만 Slack에 올린다.
# 측정값은 알림 템플릿의 .Values가 아니라 규칙 annotation의 $values로 넣는다. SNS 연락처 메시지에서 .Values를 쓰면
# 템플릿 실행이 실패해 JSON이 깨지고 Q Developer가 메시지를 버렸다(11/04, SNS 전달은 성공·Slack 미표시).
templates:
  - orgId: 1
    name: qdev
    template: |
      {{ define "qdev.json" }}{"version":"1.0","source":"custom","content":{"textType":"client-markdown","title":"{{ if eq .Status "firing" }}:rotating_light: Grafana {{ .CommonLabels.severity }}: {{ .CommonLabels.alertname }}{{ else }}:white_check_mark: Grafana 해소: {{ .CommonLabels.alertname }}{{ end }}","description":"{{ range .Alerts }}{{ .Annotations.summary }} (시작 {{ .StartsAt.Format "15:04:05 MST" }}) {{ end }}"},"metadata":{"threadId":"grafana-{{ .CommonLabels.alertname }}","summary":"Grafana {{ .CommonLabels.alertname }}"}}{{ end }}

contactPoints:
  - orgId: 1
    name: sns-slack
    receivers:
      - uid: sns-slack
        type: sns
        settings:
          topic_arn: ${alarm_topic_arn}
          sigv4:
            region: ${region}
          subject: "[Grafana] {{ .CommonLabels.alertname }}"
          message: '{{ template "qdev.json" . }}'

# 알림 지연을 재려고 그룹 대기를 짧게 둔다(CloudWatch 경로와 비교, #96)
policies:
  - orgId: 1
    receiver: sns-slack
    group_by: ["alertname"]
    group_wait: 10s
    group_interval: 1m
    repeat_interval: 4h

groups:
  - orgId: 1
    name: app
    folder: 3tier
    # 평가 주기는 Grafana 스케줄러 기본 간격(10초)의 배수여야 한다. 15초로 두었더니 프로비저닝이 실패해 Grafana가 재시작을 반복했다(11/04)
    interval: 10s
    rules:
      # 앱 컨테이너 평균 CPU(예약 0.5 vCPU 대비 %). CloudWatch ECS CPUUtilization과 같은 기준이다
      - uid: app-cpu-warning
        title: AppCpuWarning
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: prometheus
            model:
              refId: A
              expr: avg(rate(container_cpu_usage_seconds_total{container_label_com_amazonaws_ecs_container_name="board"}[1m])) / ${app_cpu_reservation} * 100
              instant: true
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: { type: gt, params: [${cpu_warning_percent}] }
        for: 3m
        noDataState: OK
        execErrState: Error
        labels: { severity: warning }
        annotations:
          summary: '앱 컨테이너 평균 CPU가 예약의 ${cpu_warning_percent}%를 3분 넘었다(현재 {{ printf "%.1f" $values.A.Value }}%)'

      - uid: app-cpu-critical
        title: AppCpuCritical
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: prometheus
            model:
              refId: A
              expr: avg(rate(container_cpu_usage_seconds_total{container_label_com_amazonaws_ecs_container_name="board"}[1m])) / ${app_cpu_reservation} * 100
              instant: true
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: { type: gt, params: [${cpu_critical_percent}] }
        for: 3m
        noDataState: OK
        execErrState: Error
        labels: { severity: critical }
        annotations:
          summary: '앱 컨테이너 평균 CPU가 예약의 ${cpu_critical_percent}%를 3분 넘었다(현재 {{ printf "%.1f" $values.A.Value }}%)'

      # 수집되는 앱 태스크가 0개(E08 탐지 공백: 태스크 2개 동시 종료 46.5~68.8초 동안 CloudWatch 알람이 울리지 않았다)
      - uid: app-no-target
        title: AppNoScrapeTarget
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 60, to: 0 }
            datasourceUid: prometheus
            model:
              refId: A
              expr: count(up{job="app"} == 1) or vector(0)
              instant: true
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: { type: lt, params: [1] }
        for: 30s
        noDataState: Alerting
        execErrState: Error
        labels: { severity: critical }
        annotations:
          summary: '지표를 내는 앱 태스크 {{ printf "%.0f" $values.A.Value }}개(0개면 전체 중단)'

      # 앱 5xx 비율(#131). DB 연결 장애(#100)에서 CPU·타깃 규칙은 울리지 않았고 CloudWatch 비상 알람만 5분 58초에 울렸다.
      # 요청이 아주 적을 때 한두 건으로 튀지 않게 분당 요청 10건 미만이면 0으로 본다(CloudWatch 5xx 알람과 같은 기준)
      - uid: app-5xx-rate
        title: AppHttp5xxRate
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 120, to: 0 }
            datasourceUid: prometheus
            model:
              refId: A
              expr: (sum(rate(http_server_requests_seconds_count{job="app",status=~"5.."}[1m])) / sum(rate(http_server_requests_seconds_count{job="app"}[1m])) * 100 and sum(rate(http_server_requests_seconds_count{job="app"}[1m])) * 60 >= ${http_5xx_min_requests}) or vector(0)
              instant: true
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: A
              conditions:
                - evaluator: { type: gt, params: [${http_5xx_rate_percent}] }
        for: 1m
        noDataState: OK
        execErrState: Error
        labels: { severity: critical }
        annotations:
          summary: '앱 5xx 응답이 ${http_5xx_rate_percent}%를 1분 넘었다(현재 {{ printf "%.1f" $values.A.Value }}%). 앱 로그(Kibana app-board-*)에서 http.response.status_code:500과 같은 요청 ID의 WARN·ERROR 확인'

  # RDS 지표는 CloudWatch에만 있어 CloudWatch 데이터 소스로 읽는다. CloudWatch 알람에서 옮겨 왔다(DEC-45·62, #95).
  # 지표가 1~5분 단위라 1분마다 평가한다(10초로 두면 GetMetricData 호출만 늘고 새 값은 없다).
  - orgId: 1
    name: rds
    folder: 3tier
    interval: 1m
    rules:
      # 스토리지는 천천히 줄어드는 값이라 5분 지표 최솟값 한 번으로 본다(옛 CloudWatch 알람과 같은 기준)
      - uid: rds-storage-low
        title: RdsStorageLow
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 1800, to: 0 }
            datasourceUid: cloudwatch
            model:
              refId: A
              queryMode: Metrics
              metricQueryType: 0
              metricEditorMode: 0
              region: default
              namespace: AWS/RDS
              metricName: FreeStorageSpace
              dimensions: { DBInstanceIdentifier: ["${db_identifier}"] }
              matchExact: true
              statistic: Minimum
              period: "300"
          - refId: B
            datasourceUid: __expr__
            model: { refId: B, type: reduce, expression: A, reducer: last, settings: { mode: dropNN } }
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [${rds_storage_low}] }
        for: 0s
        noDataState: OK
        execErrState: Error
        labels: { severity: critical }
        annotations:
          summary: 'RDS 여유 스토리지가 2 GB 미만이다(현재 {{ humanize1024 $values.B.Value }}B). 테이블·로그 크기 확인, 필요하면 allocated_storage 증설'

      # HikariCP 풀(기본 10) × 태스크 수가 평소 연결 수다. 태스크 4개에서 롤링 배포(최대 200%)를 하면 80으로 한도에 닿는다
      - uid: rds-connections-high
        title: RdsConnectionsHigh
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: cloudwatch
            model:
              refId: A
              queryMode: Metrics
              metricQueryType: 0
              metricEditorMode: 0
              region: default
              namespace: AWS/RDS
              metricName: DatabaseConnections
              dimensions: { DBInstanceIdentifier: ["${db_identifier}"] }
              matchExact: true
              statistic: Maximum
              period: "60"
          - refId: B
            datasourceUid: __expr__
            model: { refId: B, type: reduce, expression: A, reducer: last, settings: { mode: dropNN } }
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [${rds_connections_high}] }
        for: 3m
        noDataState: OK
        execErrState: Error
        labels: { severity: warning }
        annotations:
          summary: 'RDS 연결 수가 ${rds_connections_high}개를 3분 넘었다(현재 {{ printf "%.0f" $values.B.Value }}개). 태스크 수·배포 진행 여부, 연결 누수 확인'
